<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mtbHeader"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Részletes nézet"
        app:titleCentered="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtbHeader" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <EditText
                android:id="@+id/etDateR4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="Dátum"
                android:paddingHorizontal="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStartingDate" />

            <EditText
                android:id="@+id/etDateR3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="Dátum"
                android:paddingHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="@+id/etDateR"
                app:layout_constraintStart_toStartOf="@+id/etDateR"
                app:layout_constraintTop_toBottomOf="@+id/textView" />

            <ImageView
                android:id="@+id/ivBookCover"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:src="@drawable/ketarcu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RatingBar
                android:id="@+id/rbStarRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintStart_toStartOf="@+id/ivBookCover"
                app:layout_constraintTop_toBottomOf="@+id/ivBookCover" />

            <TextView
                android:id="@+id/tvBookName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:gravity="top"
                android:lineSpacingExtra="3sp"
                android:text="Én, a kéteracú\nSzerző: Ambrózy Áron György\n\nMegjelenés: 2026\nMűfaj: Képregény\nOldalak száma: 67"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@+id/ivBookCover"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivBookCover"
                app:layout_constraintTop_toTopOf="@+id/ivBookCover" />

            <TextView
                android:id="@+id/tvMaxPages"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="-10dp"
                android:gravity="center|start"
                android:text="/ 67 pages ( 90%)"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/etPages"
                app:layout_constraintEnd_toEndOf="@+id/rbStarRating"
                app:layout_constraintStart_toEndOf="@+id/etPages"
                app:layout_constraintTop_toTopOf="@+id/etPages" />

            <EditText
                android:id="@+id/etPages"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="30dp"
                android:ems="10"
                android:gravity="center"
                android:inputType="number"
                android:text="60"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rbStarRating" />

            <Spinner
                android:id="@+id/spState"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:entries="@array/BookState"
                app:layout_constraintEnd_toEndOf="@+id/tvMaxPages"
                app:layout_constraintStart_toStartOf="@+id/tvMaxPages"
                app:layout_constraintTop_toBottomOf="@+id/etPages" />

            <TextView
                android:id="@+id/tvState"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="10dp"
                android:gravity="center|start"
                android:text="Állapot:"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/spState"
                app:layout_constraintEnd_toStartOf="@+id/spState"
                app:layout_constraintStart_toStartOf="@+id/etPages"
                app:layout_constraintTop_toBottomOf="@+id/etPages" />

            <TextView
                android:id="@+id/tvBorrow"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:gravity="start|center_vertical"
                android:scrollbarSize="24sp"
                android:text="Kölcsön eddig"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/tvState"
                app:layout_constraintTop_toBottomOf="@+id/etDateR4" />

            <EditText
                android:id="@+id/etDateR"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="30dp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="Dátum"
                android:paddingHorizontal="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvBorrow"
                app:layout_constraintEnd_toEndOf="@+id/spState"
                app:layout_constraintStart_toEndOf="@+id/tvBorrow"
                app:layout_constraintTop_toTopOf="@+id/tvBorrow" />

            <TextView
                android:id="@+id/tvOpinion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Vélemény:"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBorrow" />

            <EditText
                android:id="@+id/etOpinion"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="24dp"
                android:background="@null"
                android:ems="10"
                android:gravity="start|top"
                android:hint="Vélemény nyilvánításnak a becses helye"
                android:inputType="textMultiLine"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvOpinion"
                app:layout_constraintTop_toBottomOf="@+id/etDateR" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Olvasás vége"
                app:layout_constraintStart_toStartOf="@+id/etDateR"
                app:layout_constraintTop_toBottomOf="@+id/spState" />

            <TextView
                android:id="@+id/tvStartingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Olvasás kezdete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvState" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>